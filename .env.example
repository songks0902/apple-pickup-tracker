# Copy to .env and fill in your own values: cp .env.example .env
AUTH_USER=your-user
AUTH_PASSWORD=CHANGE_ME_STRONG_RANDOM
TRACK_FAMILY=iphoneduo
TRACK_ZIP=90210
TARGET_PART=MK1H4LL/A
# Optional: force only these part numbers (comma-separated); empty = all parts from meta
PARTS=
POLL_SECONDS=120
HOST_PORT=8080
# Optional: availability alerts. ntfy example: https://ntfy.sh/your-topic
# Other webhooks receive JSON.
WEBHOOK_URL=https://ntfy.sh/your-topic
# Optional: public URL of this tracker, included in alert text
PUBLIC_URL=https://tracker.example.com
# Email alerts (same flip trigger as ntfy; skipped gracefully if SMTP_* are empty)
# Email provider example: SMTP_HOST=smtp.example.com, SMTP_USER=you@example.com, SMTP_PASSWORD=<app-password>
# Resend example: SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASSWORD=<api-key>
ALERT_EMAIL=alert@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls
# Brute-force guard: >=10 failures in 10 minutes blocks that IP for 15 minutes
AUTH_FAIL_LIMIT=10
AUTH_FAIL_WINDOW=600
AUTH_BLOCK_SECONDS=900
